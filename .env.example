# Copy to .env and adjust. See README.md Setup.
PUID=1000
PGID=1000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bobarr
POSTGRES_USER=bobarr
POSTGRES_PASSWORD=bobarr

# Optional: leave empty to run redis without a password (dev only).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Library identity / mounts
LIBRARY_MOVIES_FOLDER_NAME=movies
LIBRARY_TV_SHOWS_FOLDER_NAME=tvshows
MOVIES_LIBRARY_HOST_PATH=./library
TV_SHOWS_LIBRARY_HOST_PATH=./library

# Where active downloads are written (complete + incomplete staging).
# Point this at a large/scratch disk; the API organizes finished files from here.
DOWNLOADS_HOST_PATH=./library/downloads

MEDIA_MOUNTS=

# Service discovery / timeouts (ms)
JACKETT_BASE_URL=http://jackett:9117/api/v2.0/indexers/all
JACKETT_AUTOMATIC_SEARCH_TIMEOUT=120000
JACKETT_MANUAL_SEARCH_TIMEOUT=15000
JACKETT_SEARCH_CONCURRENCY=3
TRANSMISSION_HOST=transmission
TRANSMISSION_PORT=9091

# Auth
APP_PASSWORD=
JWT_SECRET=change-me

# API key the Mediora client uses. Leave empty and mediora-server generates one
# on first launch, shown in Settings. Set a value only to bring your own key.
SONARR_RADARR_API_KEY=

# Web UI -> API override (only for split-origin HTTPS setups)
WEB_UI_API_URL=

# Tailscale overlay (optional)
TS_AUTHKEY=
TS_EXIT_NODE=
