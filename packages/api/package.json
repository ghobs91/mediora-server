{
  "name": "@bobarr/api",
  "version": "1.0.0-beta.3",
  "description": "bobarr api server",
  "author": "iam4x <iam4x@me.com>",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "dev": "yarn && yarn ts-node-dev --interval 1000 --respawn --transpile-only -r tsconfig-paths/register --ignore-watch node_modules src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "ENV=production node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/typeorm-config.ts",
    "migration:generate": "yarn typeorm migration:generate src/migrations/$npm_config_name",
    "migration:run": "yarn typeorm migration:run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "@bull-board/ui": "^9.5.0",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.7.0",
    "body-parser": "^1.19.0",
    "bullmq": "^5.81.3",
    "child-command": "^1.0.3",
    "common-tags": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.8.23",
    "dotenv": "^8.2.0",
    "graphql": "^16.14.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "leven": "^3.1.0",
    "lodash": "^4.17.21",
    "nest-winston": "^1.10.2",
    "p-iteration": "^1.1.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.2",
    "transmission-client": "^1.0.0",
    "typeorm": "^0.3.31",
    "winston": "^3.2.1",
    "xml2json-light": "^1.0.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/common-tags": "^1.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.14.149",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "fast-check": "^2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^1.0.0-pre.44",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^5.7.0"
  }
}
